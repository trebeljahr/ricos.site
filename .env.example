# Stripe Payment Link URLs for the donate card.
# Public checkout URLs, not Stripe API secrets.
# Set each link's after-payment redirect to https://ricos.site/donate?thanks=1
# so the donor lands on the thank-you state and the inline asks go quiet.
# One-time is a single pay-what-you-want link; monthly are fixed subscription tiers.
NEXT_PUBLIC_STRIPE_DONATION_ONETIME_CUSTOM_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_3_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_5_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_10_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_25_URL=""
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=""

# Live and Learn newsletter: ListMonk, sending through Amazon SES (eu-west-1).
# NEWSLETTER_PROVIDER="mailgun" pins a deployment to Mailgun until the cutover;
# leave it unset for ListMonk. The pin goes away when Mailgun is decommissioned.
NEWSLETTER_PROVIDER=""
# Keys the Mailgun-era confirm links (?hash=&email=); keep it while those can still arrive.
SALT=""
# Mailgun: only for the pin, `pnpm newsletter:import` and `pnpm newsletter:sync-unsubscribes`.
MAILGUN_API_KEY=""
# Signs the ListMonk-era confirm links (?token=). Falls back to SALT when unset.
NEWSLETTER_TOKEN_SECRET=""
LISTMONK_URL="https://listmonk.trebeljahr.com"
LISTMONK_API_USER=""
LISTMONK_API_TOKEN=""
# The list signups join: "Live and Learn" (15) in Production, ricos.site-test (16) everywhere else.
LISTMONK_LIST_ID=""
# The chapter alerts list: "How computers work: new chapters" (19) in Production,
# ricos.site-computer-test (20) everywhere else. Unset hides it from every form;
# `pnpm newsletter:chapter <slug>` drafts campaigns on it. Takes effect at build time.
LISTMONK_COMPUTER_LIST_ID="20"
# Read by `pnpm sendNewsletter` (test list, or live list with NODE_ENV=production)
# and by `pnpm newsletter:import` and `pnpm newsletter:sync-unsubscribes` (live list).
LISTMONK_TEST_LIST_ID="16"
LISTMONK_LIVE_LIST_ID="15"
LISTMONK_TX_TEMPLATE_ID="13"
LISTMONK_CAMPAIGN_TEMPLATE_ID="14"
# Must be an address @mail.ricos.site, the site's only SES identity; the code refuses anything else.
LISTMONK_FROM="Rico Trebeljahr <noreply@mail.ricos.site>"
# Nothing receives mail at noreply@, so point replies at a real inbox.
LISTMONK_REPLY_TO="Rico Trebeljahr <rico@trebeljahr.com>"
