# Stripe Payment Link URLs for the donate card.
# Public checkout URLs, not Stripe API secrets.
# Set each link's after-payment redirect to https://ricos.site/donate?thanks=1
# so the donor lands on the thank-you state and the inline asks go quiet.
# One-time is a single pay-what-you-want link; monthly are fixed subscription tiers.
NEXT_PUBLIC_STRIPE_DONATION_ONETIME_CUSTOM_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_3_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_5_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_10_URL=""
NEXT_PUBLIC_STRIPE_DONATION_MONTHLY_25_URL=""
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=""

# Live and Learn newsletter. NEWSLETTER_PROVIDER picks the backend:
# "mailgun" (default) or "listmonk". Flipping it to "listmonk" is the cutover.
NEWSLETTER_PROVIDER=""
# Keys the Mailgun-era confirm links (?hash=&email=); keep it while those can still arrive.
SALT=""
MAILGUN_API_KEY=""
# Signs the ListMonk-era confirm links (?token=). Falls back to SALT when unset.
NEWSLETTER_TOKEN_SECRET=""
LISTMONK_URL="https://listmonk.trebeljahr.com"
LISTMONK_API_USER=""
LISTMONK_API_TOKEN=""
# The list signups join: ricos.site (15) in Production, ricos.site-test (16) everywhere else.
LISTMONK_LIST_ID=""
# Read by `pnpm sendNewsletter` (test list, or live list with NODE_ENV=production)
# and by `pnpm newsletter:import` (live list).
LISTMONK_TEST_LIST_ID="16"
LISTMONK_LIVE_LIST_ID="15"
LISTMONK_TX_TEMPLATE_ID="13"
LISTMONK_CAMPAIGN_TEMPLATE_ID="14"
LISTMONK_FROM="Rico Trebeljahr <rico@trebeljahr.com>"
LISTMONK_REPLY_TO=""
